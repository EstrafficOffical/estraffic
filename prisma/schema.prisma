generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
  OWNER
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
  BANNED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OfferMode {
  Auto
  Manual
}

enum OfferStatus {
  ACTIVE
  ARCHIVED
  PAUSED
}

enum PayoutType {
  CPA
  CPL
  CPS
  REVSHARE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversionType {
  REG
  DEP
  REBILL
  SALE
  LEAD
}

enum PartnerStatus {
  ACTIVE
  PAUSED
}

enum BrandStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CatalogVisibility {
  VISIBLE
  HIDDEN
  PRIVATE
}

enum MarketStatus {
  ACTIVE
  PAUSED
}

enum FlowStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FlowAccessMode {
  OPEN
  APPROVAL_REQUIRED
  PRIVATE
}

enum FlowAccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String?
  passwordHash      String
  image             String?
  role              Role       @default(USER)
  status            UserStatus @default(PENDING)
  tier              Int        @default(3)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  telegram          String?    @db.VarChar(191)
  assignedManagerId String?

  assignedManager      User?                  @relation("AffiliateManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  managedAffiliates    User[]                 @relation("AffiliateManager")
  application          AffiliateApplication?  @relation("ApplicantApplication")
  reviewedApplications AffiliateApplication[] @relation("ApplicationReviewer")

  flowAccesses       FlowAccess[]
  flowAccessRequests FlowAccessRequest[]
  wallets            Wallet[]
  payouts            Payout[]
  sessions           Session[]
  accounts           Account[]
  clicks             Click[]
  conversions        Conversion[]
  offerAccesses      OfferAccess[]
  offerRequests      OfferRequest[]

  @@index([role])
  @@index([status])
  @@index([tier])
  @@index([createdAt])
  @@index([telegram])
  @@index([assignedManagerId])
}

model AffiliateApplication {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  status                 ApplicationStatus @default(PENDING)
  company                String?           @db.VarChar(191)
  trafficSources         String[]
  mainGeos               String[]
  verticalInterests      String[]
  experience             String?           @db.Text
  estimatedMonthlyVolume String?           @db.VarChar(191)
  about                  String?           @db.Text
  reviewedAt             DateTime?
  reviewedById           String?
  rejectionReason        String?           @db.Text
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user       User  @relation("ApplicantApplication", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Offer {
  id       String   @id @default(cuid())
  title    String
  tag      String?
  cpa      Decimal? @db.Decimal(12, 2)
  geo      String
  vertical String
  tier     Int      @default(3)

  // legacy С‡РёСЃР»РѕРІС‹Рµ KPI вЂ” РјРѕР¶РЅРѕ РЅРµ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ
  kpi1 Float?

  kpi2 Float?

  // РќРћР’РћР•: С‚РµРєСЃС‚РѕРІС‹Рµ KPI
  kpi1Text String? @db.Text
  kpi2Text String? @db.Text

  mode             OfferMode   @default(Auto)
  status           OfferStatus @default(ACTIVE)
  targetUrl        String?     @db.Text
  hidden           Boolean     @default(false)
  trackingTemplate String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Р•РґРёРЅР°СЏ РєР°РїР°
  cap Int?

  // Р”РѕРї. РёРЅС„Рѕ (legacy)
  minDeposit Decimal? @db.Decimal(12, 2)
  holdDays   Int?
  rules      String?  @db.Text
  notes      String?  @db.Text

  accesses    OfferAccess[]
  requests    OfferRequest[]
  clicks      Click[]
  conversions Conversion[]

  @@index([title])
  @@index([geo])
  @@index([vertical])
  @@index([tier])
  @@index([status])
}

model OfferAccess {
  id        String   @id @default(cuid())
  userId    String
  offerId   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}

model OfferRequest {
  id          String        @id @default(cuid())
  userId      String
  offerId     String
  message     String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  processedAt DateTime?
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([status, createdAt])
}

model Click {
  id        String   @id @default(cuid())
  userId    String?
  offerId   String
  subId     String?
  ip        String?
  userAgent String?
  referer   String?
  country   String?
  source    String?
  sub1      String?
  sub2      String?
  sub3      String?
  sub4      String?
  sub5      String?
  campaign  String?
  adset     String?
  creative  String?
  clickId   String?
  createdAt DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([offerId, createdAt])
  @@index([subId, createdAt])
  @@index([clickId])
}

model Conversion {
  id        String         @id @default(cuid())
  userId    String?
  offerId   String
  subId     String?
  type      ConversionType
  amount    Decimal?       @db.Decimal(12, 2)
  currency  String?
  txId      String?
  createdAt DateTime       @default(now())

  // --- РќРћР’РћР•: Р±РµР·РѕРїР°СЃРЅС‹Рµ РґРѕРї. РїРѕР»СЏ РїРѕРґ FavBet ---
  externalId String? @unique
  status     String?
  source     String?
  clickId    String?
  data       Json?

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, txId])
  @@index([userId, createdAt])
  @@index([offerId, createdAt])
  @@index([subId, createdAt])
  @@index([source, status])
}

model Partner {
  id                 String        @id @default(cuid())
  name               String        @unique
  status             PartnerStatus @default(ACTIVE)
  vertical           String?       @db.VarChar(191)
  contactName        String?       @db.VarChar(191)
  contactEmail       String?       @db.VarChar(191)
  contactTelegram    String?       @db.VarChar(191)
  paymentTerms       String?       @db.VarChar(191)
  settlementCurrency String        @default("USD") @db.VarChar(12)
  integrationType    String?       @db.VarChar(64)
  internalNotes      String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  defaultBrands Brand[] @relation("BrandDefaultPartner")
  flows         Flow[]  @relation("FlowPartner")

  @@index([status])
  @@index([vertical])
}

model Brand {
  id                String            @id @default(cuid())
  name              String            @unique
  slug              String            @unique
  vertical          String            @db.VarChar(191)
  status            BrandStatus       @default(ACTIVE)
  catalogVisibility CatalogVisibility @default(VISIBLE)
  defaultPartnerId  String?
  description       String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  defaultPartner Partner? @relation("BrandDefaultPartner", fields: [defaultPartnerId], references: [id], onDelete: SetNull)
  markets        Market[]

  @@index([vertical])
  @@index([status])
  @@index([catalogVisibility])
  @@index([defaultPartnerId])
}

model Market {
  id        String       @id @default(cuid())
  brandId   String
  geo       String       @db.VarChar(12)
  name      String?      @db.VarChar(191)
  status    MarketStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  flows Flow[]

  @@unique([brandId, geo])
  @@index([geo])
  @@index([status])
}

model Flow {
  id               String         @id @default(cuid())
  marketId         String
  partnerId        String?
  name             String         @db.VarChar(191)
  trafficSource    String         @db.VarChar(191)
  approach         String?        @db.VarChar(191)
  tier             Int            @default(3)
  status           FlowStatus     @default(ACTIVE)
  accessMode       FlowAccessMode @default(APPROVAL_REQUIRED)
  trackingTemplate String?        @db.Text
  targetUrl        String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  market         Market              @relation(fields: [marketId], references: [id], onDelete: Cascade)
  partner        Partner?            @relation("FlowPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  termsVersions  FlowTermsVersion[]
  accesses       FlowAccess[]
  accessRequests FlowAccessRequest[]

  @@unique([marketId, name])
  @@index([marketId, status])
  @@index([partnerId])
  @@index([tier])
  @@index([accessMode])
}

model FlowTermsVersion {
  id                  String    @id @default(cuid())
  flowId              String
  version             Int
  advertiserCpa       Decimal?  @db.Decimal(12, 2)
  affiliateCpa        Decimal?  @db.Decimal(12, 2)
  currency            String    @default("USD") @db.VarChar(12)
  capFtd              Int?
  minDeposit          Decimal?  @db.Decimal(12, 2)
  baselineValue       Decimal?  @db.Decimal(12, 2)
  baselineDescription String?   @db.Text
  uniqueRdRequirement Decimal?  @db.Decimal(8, 2)
  wagerRequirement    Decimal?  @db.Decimal(12, 2)
  validationTiming    String?   @db.VarChar(191)
  fraudHoldDays       Int?
  kpiFallback         String?   @db.Text
  notes               String?   @db.Text
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?
  createdAt           DateTime  @default(now())

  flow     Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  accesses FlowAccess[]

  @@unique([flowId, version])
  @@index([flowId, effectiveFrom])
}

model FlowAccess {
  id                 String           @id @default(cuid())
  userId             String
  flowId             String
  termsVersionId     String?
  status             FlowAccessStatus @default(PENDING)
  customAffiliateCpa Decimal?         @db.Decimal(12, 2)
  customCapFtd       Int?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  flow         Flow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  termsVersion FlowTermsVersion? @relation(fields: [termsVersionId], references: [id], onDelete: SetNull)

  @@unique([userId, flowId])
  @@index([flowId, status])
  @@index([termsVersionId])
}

model FlowAccessRequest {
  id          String        @id @default(cuid())
  userId      String
  flowId      String
  status      RequestStatus @default(PENDING)
  message     String?       @db.Text
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([userId, flowId])
  @@index([status, createdAt])
  @@index([flowId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  verified  Boolean  @default(false)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, address])
  @@index([userId, isPrimary])
}

model Payout {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  status    String   @default("Paid")
  txHash    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model NexusTrackingLink {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  flowId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, flowId])
  @@index([flowId])
  @@index([userId, createdAt])
}

model NexusClick {
  id                    String   @id @default(cuid())
  clickId               String   @unique
  trackingLinkId        String
  userId                String
  flowId                String
  termsVersionId        String?
  sub1                  String?  @db.VarChar(191)
  sub2                  String?  @db.VarChar(191)
  sub3                  String?  @db.VarChar(191)
  sub4                  String?  @db.VarChar(191)
  sub5                  String?  @db.VarChar(191)
  source                String?  @db.VarChar(191)
  campaign              String?  @db.VarChar(191)
  adset                 String?  @db.VarChar(191)
  creative              String?  @db.VarChar(191)
  ip                    String?  @db.VarChar(191)
  userAgent             String?  @db.Text
  referer               String?  @db.Text
  destinationUrl        String?  @db.Text
  affiliateCpaSnapshot  Decimal? @db.Decimal(12, 2)
  advertiserCpaSnapshot Decimal? @db.Decimal(12, 2)
  currencySnapshot      String?  @db.VarChar(12)
  capFtdSnapshot        Int?
  createdAt             DateTime @default(now())

  @@index([trackingLinkId, createdAt])
  @@index([userId, createdAt])
  @@index([flowId, createdAt])
  @@index([termsVersionId, createdAt])
}

enum NexusConversionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

model NexusConversion {
  id               String                @id @default(cuid())
  nexusClickId     String
  clickId          String                @db.VarChar(191)
  userId           String
  flowId           String
  termsVersionId   String?
  type             ConversionType
  status           NexusConversionStatus @default(APPROVED)
  source           String                @db.VarChar(64)
  txId             String                @db.VarChar(191)
  externalId       String?               @db.VarChar(191)
  advertiserAmount Decimal?              @db.Decimal(12, 2)
  affiliatePayout  Decimal               @default(0) @db.Decimal(12, 2)
  currency         String                @default("USD") @db.VarChar(12)
  raw              Json?
  eventAt          DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([source, txId])
  @@index([clickId])
  @@index([nexusClickId])
  @@index([userId, createdAt])
  @@index([flowId, createdAt])
  @@index([termsVersionId, createdAt])
  @@index([type, status, createdAt])
}
